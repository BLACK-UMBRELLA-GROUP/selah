# SELAH repo
# Secrets — never commit (OA-AIOS-307 Finding 2, 2026-08-18)
*.env
*.key
*.pem
*.secret

# Generated local builds and resolutions are not company source records.
SOURCE/.dart_tool/
SOURCE/.flutter-plugins*
SOURCE/build/
SOURCE/ios/Pods/
SOURCE/ios/.symlinks/
SOURCE/ios/Flutter/Generated.xcconfig
SOURCE/ios/Flutter/flutter_export_environment.sh
SOURCE/ios/Flutter/ephemeral/
SOURCE/ios/Runner/GeneratedPluginRegistrant.*
SOURCE/ios/Runner/GoogleService-Info.plist
SOURCE/.env*
*.mobileprovision
*.p12
*.xcuserstate
**/xcuserdata/

# Left-overs a mounted drive creates when an open file is deleted (lesson S12, 25 Oct 2026)
.fuse_hidden*

# Public-repository hygiene: local environment, signing and generated output.
.env*
*.keystore
GoogleService-Info.plist
google-services.json
build/
.dart_tool/
